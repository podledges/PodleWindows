{
  "rules": [
    {
      "when": "The captain or task text explicitly requests Grok, the Grok CLI, harness=grok, or wording like 'send this to grok' / 'run on grok' / 'grok subagent'.",
      "use": { "harness": "grok", "effort": "high" },
      "why": "Prompt-specified Grok override. Requires the Grok Build CLI installed and authenticated. Model omitted so grok uses its account default; add model after `grok models` confirms names."
    },
    {
      "when": "The captain or task text explicitly requests Codex, harness=codex, or wording like 'send this to codex' / 'run on codex'.",
      "use": { "harness": "codex", "model": "gpt-5.5", "effort": "high" },
      "why": "Prompt-specified Codex override."
    },
    {
      "when": "The captain or task text explicitly requests Claude, Claude Code, harness=claude, or wording like 'send this to claude' / 'run on claude' (and does not name Fable/Haiku).",
      "use": { "harness": "claude", "model": "fable", "effort": "high" },
      "why": "Prompt-specified Claude override defaults to Fable; pair with the Haiku rule when the prompt names Haiku or trivial work."
    },
    {
      "when": "The captain or task text explicitly requests Pi, harness=pi, or wording like 'send this to pi' / 'run on pi'.",
      "use": { "harness": "pi", "model": "gpt-5.5", "effort": "medium" },
      "why": "Prompt-specified Pi override."
    },
    {
      "when": "The task is high-complexity technical or product design: architecture decisions, gnarly debugging, or work where depth and creativity matter more than speed.",
      "use": { "harness": "claude", "model": "fable", "effort": "high" },
      "why": "Ration Claude quota for high-complexity design (Fable)."
    },
    {
      "when": "The task is a trivial mechanical edit such as a rote rename, formatting sweep, targeted typo fix, or simple file gathering.",
      "use": { "harness": "claude", "model": "haiku", "effort": "low" },
      "why": "Cheapest fast profile for narrow, low-ambiguity work."
    },
    {
      "when": "The task is a big or ambiguous multi-file feature, a risky refactor, or work that requires holding many moving parts in mind.",
      "use": [
        { "harness": "claude", "model": "fable", "effort": "high" },
        { "harness": "pi", "model": "gpt-5.5", "effort": "high" }
      ],
      "why": "Strong profile for big ambiguous work; array lets dispatch fall through to Pi when Claude quota is low."
    }
  ],
  "default": { "harness": "pi", "model": "gpt-5.5", "effort": "medium" }
}
